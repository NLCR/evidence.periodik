# Copy this file to .env and fill in local-only values.
# The file can be loaded by Docker Compose or the IDE run configuration.
# Generate secrets with: openssl rand -base64 48

IDENTITY_JWT_SECRET=
IDENTITY_DEV_PASSWORD=
IDENTITY_DATABASE_PASSWORD=
EXPORT_API_DATABASE_PASSWORD=

# Dedicated core/export service credential, not an identity JWT secret.
# Generate locally with: openssl rand -hex 32
# Supplied only to permonik-api and permonik-export-api by Compose.
CORE_EXPORT_GRPC_TOKEN=
